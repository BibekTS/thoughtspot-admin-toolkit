    { "name": "integration", "cmd": "pytest tests/integration/ -v", "when": "always", "cheap": true, "note": "in-memory TestClient, binds no port" },
    { "name": "typecheck", "cmd": "cd frontend && npx tsc --noEmit", "when": "always", "cheap": true },
    { "name": "build", "cmd": "cd frontend && npm run build", "when": "always", "cheap": false, "note": "writes ts_admin/static/; QA only, never in parallel worktrees" },
    { "name": "feature-check", "cmd": "", "when": "always", "note": "supplied by the CEO's brief per backlog row; /test for the coverage-aware slice" }
  ],
  "gate_files": ["frontend/tsconfig.json", "frontend/vitest.config.mts", "frontend/playwright.config.ts"],
  "protected_paths": ["CLAUDE.md", ".github/workflows/**", ".env*",
    "ts_admin/main.py", "ts_admin/services/cluster_service.py", "ts_admin/cli.py", "ts_admin/config.py",
    "tests/integration/test_dryrun_safety.py", "tests/integration/test_cluster_isolation.py",
    "tests/integration/test_audit_log_writes.py", "tests/unit/test_cluster_service.py",
    ".claude/ceo/org.json", ".claude/ceo/AUTONOMY.md", ".claude/settings.json", ".claude/hooks/**"],
  "user_data_paths": ["~/.ts-admin/**"],
