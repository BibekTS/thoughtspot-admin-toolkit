  "stores": {
    "rules": "CLAUDE.md",
    "tasks": "BACKLOG.md",
    "facts": "docs/org-memory/",
    "note": "Adopted org: the .claude/ceo/ backlog and memory files are pointers to these stores, not copies."
  },
  "agents": [
    { "name": "researcher", "access": "report-only", "role": "researcher", "perimeter": [], "except": [] },
    { "name": "architect", "access": "report-only", "role": "architect", "perimeter": [], "except": [] },
    { "name": "implementer", "access": "editor", "role": "editor",
