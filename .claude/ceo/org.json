      "except": ["ts_admin/static/**"] },
    { "name": "reviewer", "access": "report-only", "role": "reviewer", "perimeter": [], "except": [] },
    { "name": "qa-verifier", "access": "report-only", "role": "release-manager", "perimeter": [], "except": [] },
    { "name": "bug-hunter", "access": "report-only", "role": "bug-hunter", "perimeter": [], "except": [] }
